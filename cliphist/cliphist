import sys
import time
import json
import subprocess
import os

FILE = os.path.expanduser("~/.cliphist.json")


def main():
    if sys.argv[1] == "start":
        history = []

        while True:
            try:
                text = subprocess.check_output(
                    ["wl-paste", "-n"], text=True
                )
            except:
                try:
                    text = subprocess.check_output(
                        ["xclip", "-selection", "clipboard", "-o"],
                        text=True
                    )
                except:
                    text = ""

            if text and (not history or text != history[0]):
                history.insert(0, text)
                history = history[:100]

                with open(FILE, "w") as f:
                    json.dump(history, f)

            time.sleep(1)

if __name__ == "__main__":
    main()

