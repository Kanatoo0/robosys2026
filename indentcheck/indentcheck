import sys


def check_indent(source):
    errors = []
    lines = source.splitlines()

    for i, line in enumerate(lines, 1):
        if line.strip() == "":
            continue

        # 行頭の空白とタブを取得
        leading = line[:len(line) - len(line.lstrip(" \t"))]


        if "\t" in leading:
            errors.append(f"Line {i}: Tab detected.")
            continue

        # インデントの幅を確認
        indent = len(leading)

        if indent % 4 != 0:
            errors.append(
                f"Line {i}: Indentation is not a multiple of 4."
            )

    # エラーの表示
    for error in errors:
        print(error, file=sys.stderr)



if __name__ == "__main__":
    source = sys.stdin.read()
    sys.exit(check_indent(source))
