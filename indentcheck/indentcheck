import sys


def check_indent(source):
    errors = []
    lines = source.splitlines()

    for i, line in enumerate(lines, 1):
        if line.strip() == "":
            continue


        leading = line[:len(line) - len(line.lstrip(" \t"))]

        if "\t" in leading:
            errors.append(f"Line {i}: Tab detected.")
            continue

        indent = len(leading)

        if indent % 4 != 0:
            errors.append(
                f"Line {i}: Indentation is not a multiple of 4."
            )

    for error in errors:
        print(error, file=sys.stderr)

    if errors:
        print(f"{len(errors)} indentation error(s) found.", file=sys.stderr)
    else:
        print("No indentation errors found.", file=sys.stderr)

    return 1 if errors else 0


if __name__ == "__main__":
    source = sys.stdin.read()
    sys.exit(check_indent(source))
